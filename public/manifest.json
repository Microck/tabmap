{
  "manifest_version": 3,
  "key": "",
  "name": "Tabmap",
  "version": "0.1.0",
  "description": "Preview and organize related tabs with your Codex login or an OpenAI-compatible model.",
  "minimum_chrome_version": "120",
  "permissions": ["tabs", "tabGroups", "storage", "sidePanel", "nativeMessaging"],
  "optional_host_permissions": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*", "http://[::1]/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": {
    "default_title": "Tabmap",
    "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" }
  },
  "side_panel": { "default_path": "panel.html" },
  "incognito": "not_allowed",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'" }
}
